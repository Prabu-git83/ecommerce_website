{
  "name": "ecommerce-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "website",
    "admin"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres redis minio mailpit",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:website": "npm run dev --workspace website",
    "dev:admin": "npm run dev --workspace admin",
    "dev": "concurrently -n backend,website,admin -c blue,magenta,green \"npm run dev:backend\" \"npm run dev:website\" \"npm run dev:admin\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
