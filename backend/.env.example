NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgres://ecommerce:ecommerce_dev_password@localhost:5433/ecommerce

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_dev_access_secret_please_rotate
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_please_rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ecommerce
S3_SECRET_KEY=ecommerce_dev_password
S3_BUCKET=product-images
S3_PUBLIC_URL=http://localhost:9000/product-images

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Arca <no-reply@arca.local>"

WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173

COOKIE_SECRET=change_me_dev_cookie_secret
CART_COOKIE_NAME=arca_cart

# --- Production / Vercel + Supabase (see DEPLOY.md) ---
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_POOLED=true        # required for the :6543 transaction pooler
# DATABASE_POOL_MAX=1         # one connection per serverless instance
# MAX_UPLOAD_MB=4             # Vercel functions cap request bodies at ~4.5MB
# S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# S3_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/product-images
# SMTP_USER= / SMTP_PASS= / SMTP_SECURE=false   # e.g. Brevo smtp-relay.brevo.com:587
# ADMIN_INITIAL_PASSWORD=     # used once by db:setup for admin@arca.local
